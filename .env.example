# Copy this to .env and fill in the values. .env is listed in .gitignore, so it never goes into the repository.
NEBIUS_API_KEY=

# Optional
# SCENEPILOT_VISION_MODEL=nvidia/Nemotron-3.5-Super-VL
# SCENEPILOT_MAX_IMAGE_BYTES=8388608

# NVIDIA API key, only for tools/synthesize_prompts.py (makes the spoken guidance audio). Get it at
# https://build.nvidia.com/nvidia/magpie-tts-multilingual ("Get API Key"). Never commit it.
# NVIDIA_API_KEY=nvapi-...
# The model behind "Ask a question" (an NVIDIA Nemotron text model on Nebius Token Factory with tool calling).
# SCENEPILOT_ASSISTANT_MODEL=nvidia/nemotron-3-super-120b-a12b

# Rate limits per address for the calls that cost model credits (counts per 10 minutes). Defaults shown.
# SCENEPILOT_RATE_PHOTOS=25
# SCENEPILOT_RATE_ASKS=20
# SCENEPILOT_RATE_SESSIONS=30
# SCENEPILOT_RATE_WINDOW=600
# SCENEPILOT_RATE_LIMIT=off          # switches all of the above off
# Behind a proxy (Render, for example) set this to the number of trusted proxies in front of the app, so the real caller's
# address is used. Left at 0 the header is ignored and every caller behind the proxy would share one allowance.
# SCENEPILOT_PROXY_HOPS=1

# Let the Android app (it runs from https://localhost) call this server. Leave empty for the web UI only.
# SCENEPILOT_CORS_ORIGINS=https://localhost
